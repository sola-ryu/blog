---
import type { CollectionEntry } from "astro:content"
import BaseHead from "../components/BaseHead.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import FormattedDate from "../components/FormattedDate.astro"
import Sticker from "../components/stickers/Sticker.astro"

import ChevronsLeft from "../../content/assets/lucide/chevrons-left.svg"
import ChevronsRight from "../../content/assets/lucide/chevrons-right.svg"

type Props = {
  prev?: CollectionEntry<"blog">
  next?: CollectionEntry<"blog">
  data: CollectionEntry<"blog">["data"]
}

const {
  prev,
  next,
  data: { title, description, date, sticker },
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <Header />
    <div class="mx-safe my-4 px-4 md:p-6 lg:px-12">
      <main class="mx-auto max-w-7xl">
        <article>
          <header class="flex items-start gap-4 pb-8 sm:gap-6 sm:pb-12 lg:pb-16">
            {sticker && (
              <div class="mt-1 shrink-0">
                <Sticker name={sticker} size={104} label={`${sticker} sticker`} />
              </div>
            )}
            <div class="font-display">
              <h1
                class="doodle-underline mb-2 inline-block text-4xl font-bold text-[#3d3129] md:mb-4 md:text-5xl dark:text-[#efe4cf]"
              >
                {title}
              </h1>
              <div class="font-handwritten mt-1 text-lg text-[#8a6f4d] md:mt-2 dark:text-[#b8a88e]">
                <FormattedDate date={date} />
              </div>
            </div>
          </header>
          <div class="paper-card relative rounded-sm px-6 py-6 lg:px-10 lg:py-8">
            <div
              class="tape -top-3 left-10 rotate-3"
              aria-hidden="true"
            />
            <div class="prose-all">
              <slot />
            </div>
          </div>
        </article>

        <nav class="md:mt-8 lg:mt-12">
          <ul class="justify-space-between list-style-none flex flex-wrap p-0">
            {
              prev && (
                <li class="mr-4 mb-4 sm:mb-0">
                  <a
                    class="paper-card flex items-center gap-2 rounded-full px-4 py-2 font-bold text-[#7c2d12] hover:brightness-95 dark:text-amber-200"
                    href={`/${prev.id}/`}
                    rel="prev"
                  >
                    <ChevronsLeft class="-mx-1" />
                    {prev.data.title}
                  </a>
                </li>
              )
            }
            {
              next && (
                <li class="ml-auto">
                  <a
                    class="paper-card flex items-center gap-2 rounded-full px-4 py-2 font-bold text-[#7c2d12] hover:brightness-95 dark:text-amber-200"
                    href={`/${next.id}/`}
                    rel="next"
                  >
                    {next.data.title}
                    <ChevronsRight class="-mx-1" />
                  </a>
                </li>
              )
            }
          </ul>
        </nav>
      </main>
    </div>
    <Footer />
  </body>
</html>
