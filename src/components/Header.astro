---
import HeaderLink from "./HeaderLink.astro"
import Sticker from "./stickers/Sticker.astro"
import { SITE_TITLE } from "../consts"
---

<header
  class="relative border-b-2 border-dashed border-[#d8c9a8] bg-[#fffdf6]/90 backdrop-blur-sm dark:border-[#4a3f30] dark:bg-[#2c251d]/90"
>
  <div class="px-safe relative z-10 mx-auto max-w-7xl p-4 md:p-6 lg:px-12">
    <nav
      class="flex flex-col items-stretch gap-4 text-[#5a4a3c] sm:flex-row dark:text-[#d8cbb4]"
    >
      <div class="flex flex-1 items-center gap-2">
        <a
          href="/"
          class="font-display mr-2 flex items-center gap-1 rounded-xs text-3xl font-bold transition duration-150 ease-in-out focus:outline-hidden focus-visible:ring-3 focus-visible:ring-amber-400 sm:mr-6 lg:gap-2"
        >
          <Sticker name="pizza-slice" size={52} label="Pizza slice sticker" />
          <span class="hidden sm:block">{SITE_TITLE}</span>
        </a>
        <HeaderLink href="/archive">Archive</HeaderLink>
        <HeaderLink href="/about">About</HeaderLink>
      </div>

      <div class="relative sm:w-84" data-site-search-root>
        <form class="flex items-center" role="search">
          <label class="sr-only" for="site-search">Search posts</label>
          <input
            id="site-search"
            name="q"
            type="search"
            placeholder="Search posts"
            data-site-search
            autocomplete="off"
            class="font-display w-full rounded-full border border-[#d8c9a8] bg-white/70 px-4 py-2 text-sm leading-5 text-[#3d3129] shadow-sm ring-amber-400 transition focus:border-amber-400 focus:ring-3 focus:outline-none dark:border-[#4a3f30] dark:bg-[#221c16] dark:text-[#e8ddcb] dark:ring-amber-600"
          />
        </form>
        <div
          hidden
          data-site-search-popover
          class="absolute top-full right-0 left-0 z-30 mt-2 overflow-hidden rounded-2xl border border-[#d8c9a8] bg-[#fffdf6] shadow-xl shadow-[#46322b]/20 dark:border-[#4a3f30] dark:bg-[#2c251d]"
        >
          <p
            data-site-search-status
            class="font-display border-b border-[#e7dcc4] px-4 py-2 text-sm text-[#5a4a3c] dark:border-[#4a3f30] dark:text-[#d8cbb4]"
          >
          </p>
          <ul
            data-site-search-results
            class="max-h-96 divide-y divide-[#e7dcc4] overflow-y-auto scroll-auto dark:divide-[#4a3f30]"
          >
          </ul>
        </div>
      </div>
    </nav>
    <slot />
  </div>
</header>

<script>
  import "../js/header-search.js"
</script>
