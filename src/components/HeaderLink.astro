---
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"a">

const { href, ...props } = Astro.props
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "")
const subpath = pathname.match(/[^\/]+/g)
const isActive = href === pathname || href === "/" + (subpath?.[0] || "")
---

<a
  href={href}
  class:list={`font-display rounded-full px-4 py-2 text-sm leading-5 font-bold ${
    isActive
      ? "shadow-solid bg-amber-100 text-[#7c2d12] shadow-[#7c2d12] ring-amber-500 hover:ring-3 focus:ring-3 dark:bg-amber-900 dark:text-amber-100 dark:shadow-black"
      : "text-[#7a6753] ring-amber-500/60 hover:ring-3 focus:ring-3 dark:text-[#b8a88e]"
  }`}
  {...props}
>
  <slot />
</a>
