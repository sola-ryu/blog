---
/**
 * Sticker — a hand-drawn-style die-cut sticker.
 *
 * Renders one of the named sticker designs as inline SVG with an automatic
 * white die-cut border (via an SVG dilate filter), a soft drop shadow, a
 * deterministic slight rotation, a holographic shine sweep on hover, and an
 * optional peeled-corner effect.
 */

export const stickerNames = [
  "pizza-slice",
  "vr-headset",
  "ditto-blob",
  "flip-phone",
  "eink-phone",
  "penguin",
  "game-controller",
  "cube-pc",
  "code-brackets",
  "hard-drive",
  "cracked-window",
  "paintbrush",
  "database",
  "camera",
  "playdate",
  "lime-wedge",
  "book-stack",
  "clipboard",
  "compass",
  "ellipsis",
] as const

export type StickerName = (typeof stickerNames)[number]

interface Props {
  /** One of the stickerNames above. Unknown names render nothing. */
  name: StickerName | string
  /** Pixel size (square). Defaults to 96. */
  size?: number
  /** Rotation in degrees. Defaults to a deterministic wobble derived from the name. */
  rotate?: number
  /** Show a peeled-corner fold. Defaults to true. */
  peel?: boolean
  /** Accessible label for the sticker art. */
  label?: string
  class?: string
}

const {
  name,
  size = 96,
  peel = true,
  label,
  class: className,
} = Astro.props

const INK = "#46322b"

function hashStr(s: string): number {
  let h = 7
  for (const c of s) h = (h * 31 + c.charCodeAt(0)) | 0
  return Math.abs(h)
}

const rotation = Astro.props.rotate ?? ((hashStr(name) % 13) - 6)

