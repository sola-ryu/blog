const art = ART[name]
---

{
  art && (
    <span
      class:list={["sticker", className]}
      style={`--sticker-size: ${size}px; --sticker-rotate: ${rotation}deg;`}
      role={label ? "img" : undefined}
      aria-label={label}
    >
      <svg
        viewBox="0 0 120 120"
        width={size}
        height={size}
        aria-hidden={label ? undefined : "true"}
      >
        <defs>
          <filter
            id="sticker-diecut"
            x="-25%"
            y="-25%"
            width="150%"
            height="150%"
          >
            <feMorphology
              in="SourceAlpha"
              operator="dilate"
              radius="7"
              result="dilated"
            />
            <feFlood flood-color="#fffdf8" result="paper" />
            <feComposite in="paper" in2="dilated" operator="in" result="border" />
            <feMerge>
              <feMergeNode in="border" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
          <filter
            id="sticker-wobble"
            x="-25%"
            y="-25%"
            width="150%"
            height="150%"
          >
            <feTurbulence
              type="fractalNoise"
              baseFrequency="0.02"
              numOctaves="2"
              seed="7"
              result="noise"
            />
            <feDisplacementMap
              in="SourceGraphic"
              in2="noise"
              scale="4"
            />
          </filter>
        </defs>
        <g filter="url(#sticker-diecut)">
          <g filter="url(#sticker-wobble)" set:html={art} />
        </g>
      </svg>
      <span class="holo" aria-hidden="true" />
      {peel && <span class="peel" aria-hidden="true" />}
    </span>
  )
}

<style>
  .sticker {
    position: relative;
    display: inline-block;
    width: var(--sticker-size);
    height: var(--sticker-size);
    transform: rotate(var(--sticker-rotate));
    transition: transform 0.25s ease;
  }
  .sticker svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 5px 6px rgba(70, 50, 43, 0.28));
    transition: transform 0.25s ease;
  }
  .sticker:hover {
    transform: rotate(0deg) scale(1.07);
  }
  .sticker .holo {
    position: absolute;
    inset: -6%;
    pointer-events: none;
    opacity: 0;
    border-radius: 22%;
    background: linear-gradient(
      115deg,
      transparent 28%,
      rgba(255, 122, 200, 0.38) 42%,
      rgba(122, 220, 255, 0.38) 55%,
      rgba(255, 232, 122, 0.32) 66%,
      transparent 80%
    );
    background-size: 260% 260%;
    background-position: 120% 0;
    mix-blend-mode: color-dodge;
    transition: opacity 0.25s ease;
  }
  .sticker:hover .holo {
    opacity: 1;
    animation: sticker-holo-sweep 1.1s ease;
  }
  @keyframes sticker-holo-sweep {
    from {
      background-position: 120% 0;
    }
    to {
      background-position: -30% 0;
    }
  }
  .sticker .peel {
    position: absolute;
    right: 4%;
    bottom: 4%;
    width: 24%;
    height: 24%;
    background: linear-gradient(
      to top left,
      #fffdf8 46%,
      #e8ddc8 47%,
      rgba(70, 50, 43, 0.22) 52%,
      transparent 55%
    );
    clip-path: polygon(100% 0, 0 100%, 100% 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .sticker,
    .sticker svg,
    .sticker .holo {
      transition: none;
      animation: none;
    }
  }
</style>
