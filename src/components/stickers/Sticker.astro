  "eink-phone": `
    <rect x="38" y="12" width="44" height="96" rx="10" fill="#e9e4d8" stroke="${INK}" stroke-width="4"/>
    <rect x="46" y="24" width="28" height="52" fill="#f4f4f2" stroke="${INK}" stroke-width="2.5"/>
    <rect x="50" y="30" width="20" height="12" fill="#c9c4b6"/>
    <rect x="50" y="46" width="20" height="4" fill="#b9b3a5"/>
    <rect x="50" y="53" width="14" height="4" fill="#b9b3a5"/>
    <rect x="50" y="60" width="18" height="4" fill="#b9b3a5"/>
    <circle cx="60" cy="90" r="4" fill="none" stroke="${INK}" stroke-width="3"/>
    <rect x="52" y="14" width="16" height="4" rx="2" fill="${INK}"/>`,
  penguin: `
    <ellipse cx="60" cy="64" rx="26" ry="34" fill="#3a3f4d" stroke="${INK}" stroke-width="4"/>
    <ellipse cx="60" cy="74" rx="15" ry="22" fill="#fdfbf5"/>
    <circle cx="51" cy="48" r="6.5" fill="#fdfbf5" stroke="${INK}" stroke-width="2.5"/>
    <circle cx="69" cy="48" r="6.5" fill="#fdfbf5" stroke="${INK}" stroke-width="2.5"/>
    <circle cx="51" cy="49" r="2.5" fill="${INK}"/>
    <circle cx="69" cy="49" r="2.5" fill="${INK}"/>
    <path d="M60 56 L54 62 L66 62 Z" fill="#f0a03c" stroke="${INK}" stroke-width="2" stroke-linejoin="round"/>
    <path d="M36 60 Q28 72 34 82" fill="none" stroke="${INK}" stroke-width="4" stroke-linecap="round"/>
    <path d="M84 60 Q92 72 86 82" fill="none" stroke="${INK}" stroke-width="4" stroke-linecap="round"/>
    <ellipse cx="50" cy="100" rx="7" ry="4" fill="#f0a03c" stroke="${INK}" stroke-width="2.5"/>
    <ellipse cx="70" cy="100" rx="7" ry="4" fill="#f0a03c" stroke="${INK}" stroke-width="2.5"/>`,
  "game-controller": `
    <path d="M28 54 Q28 44 38 44 L50 44 Q58 44 62 50 Q66 44 74 44 L84 44 Q92 44 92 54 L88 78 Q86 88 76 86 Q68 84 65 76 L57 76 Q54 84 46 86 Q36 88 34 78 Z" fill="#d95f6e" stroke="${INK}" stroke-width="4" stroke-linejoin="round"/>
    <rect x="42" y="58" width="14" height="5" rx="2" fill="#fdfbf5"/>
    <rect x="46.5" y="53.5" width="5" height="14" rx="2" fill="#fdfbf5"/>
    <g fill="#ffe08a" stroke="${INK}" stroke-width="2">
      <circle cx="74" cy="58" r="3.6"/><circle cx="82" cy="64" r="3.6"/><circle cx="66" cy="64" r="3.6"/><circle cx="74" cy="70" r="3.6"/>
    </g>`,
  "cube-pc": `
    <path d="M60 26 L86 41 L60 56 L34 41 Z" fill="#a8c3d1" stroke="${INK}" stroke-width="3" stroke-linejoin="round"/>
    <path d="M34 41 L60 56 L60 94 L34 79 Z" fill="#7d9db3" stroke="${INK}" stroke-width="3" stroke-linejoin="round"/>
    <path d="M86 41 L60 56 L60 94 L86 79 Z" fill="#5f7f96" stroke="${INK}" stroke-width="3" stroke-linejoin="round"/>
    <circle cx="73" cy="70" r="5" fill="#9fe870" stroke="${INK}" stroke-width="2.5"/>
    <path d="M41 52 L41 70 M41 58 L51 64" stroke="${INK}" stroke-width="2.5" stroke-linecap="round"/>`,
