    <path d="M104 56 Q90 50 84 58" fill="none" stroke="${INK}" stroke-width="5" stroke-linecap="round"/>
    <rect x="32" y="42" width="56" height="36" rx="16" fill="#46536e" stroke="${INK}" stroke-width="4"/>
    <circle cx="48" cy="60" r="9" fill="#9fd8e8" stroke="${INK}" stroke-width="3"/>
    <circle cx="72" cy="60" r="9" fill="#9fd8e8" stroke="${INK}" stroke-width="3"/>
    <circle cx="45" cy="57" r="2.5" fill="#ffffff"/>
    <circle cx="69" cy="57" r="2.5" fill="#ffffff"/>`,
  "ditto-blob": `
    <path d="M60 32 C82 32 93 50 90 70 C87 90 74 100 59 99 C42 98 30 88 31 69 C32 50 43 32 60 32 Z" fill="#b48be0" stroke="${INK}" stroke-width="4" stroke-linejoin="round"/>
    <circle cx="44" cy="30" r="6" fill="#b48be0" stroke="${INK}" stroke-width="3"/>
    <circle cx="77" cy="33" r="5" fill="#b48be0" stroke="${INK}" stroke-width="3"/>
    <circle cx="50" cy="62" r="4" fill="${INK}"/>
    <circle cx="70" cy="62" r="4" fill="${INK}"/>
    <path d="M52 74 Q60 80 68 74" fill="none" stroke="${INK}" stroke-width="3" stroke-linecap="round"/>
    <path d="M34 78 Q28 84 32 90" fill="none" stroke="${INK}" stroke-width="3" stroke-linecap="round"/>
    <path d="M86 78 Q92 84 88 90" fill="none" stroke="${INK}" stroke-width="3" stroke-linecap="round"/>`,
  "flip-phone": `
    <path d="M44 16 L76 20 L72 54 L40 50 Z" fill="#8fd0d8" stroke="${INK}" stroke-width="4" stroke-linejoin="round"/>
