    <rect x="40" y="56" width="32" height="8" fill="#6b5b54"/>
    <path d="M40 66 L68 70 L64 104 L36 100 Z" fill="#f2e7d5" stroke="${INK}" stroke-width="4" stroke-linejoin="round"/>
