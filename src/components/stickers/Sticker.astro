    <circle cx="53" cy="52" r="7" fill="#d95f4b" stroke="${INK}" stroke-width="3"/>
    <circle cx="66" cy="64" r="7" fill="#d95f4b" stroke="${INK}" stroke-width="3"/>
    <circle cx="58" cy="79" r="5.5" fill="#d95f4b" stroke="${INK}" stroke-width="3"/>
    <path d="M44 36 q5 6 1 12" stroke="#e8a93d" stroke-width="3" fill="none" stroke-linecap="round"/>`,
  "vr-headset": `
