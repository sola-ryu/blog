    <path d="M68 26 L52 94" fill="none" stroke="#f0a03c" stroke-width="8" stroke-linecap="round"/>`,
  "hard-drive": `
    <rect x="22" y="38" width="76" height="44" rx="10" fill="#b9c2cc" stroke="${INK}" stroke-width="4"/>
    <circle cx="52" cy="60" r="14" fill="#e8edf2" stroke="${INK}" stroke-width="3"/>
    <circle cx="52" cy="60" r="3" fill="${INK}"/>
    <path d="M84 46 L60 58" stroke="${INK}" stroke-width="4" stroke-linecap="round"/>
    <g fill="${INK}">
      <circle cx="30" cy="46" r="2.4"/><circle cx="90" cy="46" r="2.4"/><circle cx="30" cy="74" r="2.4"/><circle cx="90" cy="74" r="2.4"/>
    </g>`,
  "cracked-window": `
    <rect x="30" y="24" width="60" height="72" fill="#cfe3ec" stroke="${INK}" stroke-width="5" stroke-linejoin="round"/>
    <path d="M60 24 L60 96 M30 60 L90 60" stroke="${INK}" stroke-width="3"/>
    <path d="M60 24 L54 38 L64 48 L52 60 L60 74 L50 96" fill="none" stroke="${INK}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M64 48 L74 44 M52 60 L42 58" stroke="${INK}" stroke-width="2.5" stroke-linecap="round"/>`,
  paintbrush: `
    <path d="M34 88 L62 60" stroke="#b06a4a" stroke-width="11" stroke-linecap="round"/>
    <path d="M62 60 L74 48" stroke="#c9cfd6" stroke-width="13" stroke-linecap="round"/>
    <path d="M72 50 L90 30 L80 52 Z" fill="#3fa7a0" stroke="${INK}" stroke-width="3" stroke-linejoin="round"/>
    <circle cx="93" cy="26" r="7" fill="#3fa7a0" stroke="${INK}" stroke-width="3"/>
    <circle cx="84" cy="18" r="3.5" fill="#3fa7a0"/>
    <circle cx="102" cy="34" r="3" fill="#3fa7a0"/>`,
  database: `
    <path d="M32 40 L32 80 Q32 92 60 92 Q88 92 88 80 L88 40" fill="#b9cfdd" stroke="${INK}" stroke-width="4"/>
    <ellipse cx="60" cy="40" rx="28" ry="11" fill="#dfeaf2" stroke="${INK}" stroke-width="4"/>
    <path d="M32 58 Q60 69 88 58" fill="none" stroke="${INK}" stroke-width="3"/>
    <path d="M32 74 Q60 85 88 74" fill="none" stroke="${INK}" stroke-width="3"/>
    <ellipse cx="60" cy="40" rx="12" ry="5" fill="#9fc3d8"/>`,
  camera: `
    <rect x="26" y="46" width="68" height="40" rx="9" fill="#4a4f5e" stroke="${INK}" stroke-width="4"/>
    <rect x="44" y="36" width="22" height="12" rx="3" fill="#4a4f5e" stroke="${INK}" stroke-width="4"/>
    <circle cx="60" cy="66" r="14" fill="#20242e" stroke="${INK}" stroke-width="3"/>
    <circle cx="60" cy="66" r="7" fill="#7fb2d9"/>
    <circle cx="57" cy="63" r="2.4" fill="#eaf4fb"/>
    <rect x="80" y="52" width="8" height="6" rx="1.5" fill="#f6e3a1" stroke="${INK}" stroke-width="2"/>`,
}

const art = ART[name]
---

{
  art && (
    <span
      class:list={["sticker", className]}
      style={`--sticker-size: ${size}px; --sticker-rotate: ${rotation}deg;`}
      role={label ? "img" : undefined}
      aria-label={label}
    >
      <svg
        viewBox="0 0 120 120"
        width={size}
        height={size}
        aria-hidden={label ? undefined : "true"}
      >
        <defs>
          <filter
            id="sticker-diecut"
            x="-25%"
            y="-25%"
            width="150%"
            height="150%"
          >
            <feMorphology
              in="SourceAlpha"
              operator="dilate"
              radius="7"
              result="dilated"
            />
            <feFlood flood-color="#fffdf8" result="paper" />
            <feComposite in="paper" in2="dilated" operator="in" result="border" />
            <feMerge>
              <feMergeNode in="border" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
          <filter
            id="sticker-wobble"
            x="-25%"
            y="-25%"
            width="150%"
            height="150%"
          >
            <feTurbulence
              type="fractalNoise"
              baseFrequency="0.02"
              numOctaves="2"
              seed="7"
              result="noise"
            />
            <feDisplacementMap
              in="SourceGraphic"
              in2="noise"
              scale="4"
            />
          </filter>
        </defs>
        <g filter="url(#sticker-diecut)">
          <g filter="url(#sticker-wobble)" set:html={art} />
        </g>
      </svg>
      <span class="holo" aria-hidden="true" />
      {peel && <span class="peel" aria-hidden="true" />}
    </span>
  )
}

<style>
  .sticker {
    position: relative;
    display: inline-block;
    width: var(--sticker-size);
    height: var(--sticker-size);
    transform: rotate(var(--sticker-rotate));
    transition: transform 0.25s ease;
  }
  .sticker svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 5px 6px rgba(70, 50, 43, 0.28));
    transition: transform 0.25s ease;
  }
  .sticker:hover {
    transform: rotate(0deg) scale(1.07);
  }
  .sticker .holo {
    position: absolute;
    inset: -6%;
    pointer-events: none;
    opacity: 0;
    border-radius: 22%;
    background: linear-gradient(
      115deg,
      transparent 28%,
      rgba(255, 122, 200, 0.38) 42%,
      rgba(122, 220, 255, 0.38) 55%,
      rgba(255, 232, 122, 0.32) 66%,
      transparent 80%
    );
    background-size: 260% 260%;
    background-position: 120% 0;
    mix-blend-mode: color-dodge;
    transition: opacity 0.25s ease;
  }
  .sticker:hover .holo {
    opacity: 1;
    animation: sticker-holo-sweep 1.1s ease;
  }
  @keyframes sticker-holo-sweep {
    from {
      background-position: 120% 0;
    }
    to {
      background-position: -30% 0;
    }
  }
  .sticker .peel {
    position: absolute;
    right: 4%;
    bottom: 4%;
    width: 24%;
    height: 24%;
    background: linear-gradient(
      to top left,
      #fffdf8 46%,
      #e8ddc8 47%,
      rgba(70, 50, 43, 0.22) 52%,
      transparent 55%
    );
    clip-path: polygon(100% 0, 0 100%, 100% 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .sticker,
    .sticker svg,
    .sticker .holo {
      transition: none;
      animation: none;
    }
  }
</style>
