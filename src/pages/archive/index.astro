---
import BaseHead from "../../components/BaseHead.astro"
import Header from "../../components/Header.astro"
import Footer from "../../components/Footer.astro"
import Sticker from "../../components/stickers/Sticker.astro"
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts"
import { getCollection } from "astro:content"
import type { CollectionEntry } from "astro:content"
import FormattedDate from "../../components/FormattedDate.astro"

type BlogPost = CollectionEntry<"blog"> & { excerpt?: string }

const posts = ((await getCollection("blog")) as BlogPost[]).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

const years: number[] = []
posts.forEach(post => {
  const y = new Date(post.data.date).getFullYear()
  if (years.indexOf(y) === -1) {
    years.push(y)
  }
})

const postsByYear: Record<number, BlogPost[]> = {}
posts.forEach(post => {
  const y = new Date(post.data.date).getFullYear()
  if (postsByYear[y] === undefined) {
    postsByYear[y] = []
  }
  postsByYear[y].push(post)
})
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Archive — ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
    />
  </head>
  <body>
    <Header>
      <div class="font-display mt-6 pt-4 sm:py-8 md:py-12 lg:mt-8">
        <h1
          class="doodle-underline inline-block text-4xl font-bold text-[#3d3129] md:text-5xl dark:text-[#efe4cf]"
        >
          Blog Archive
        </h1>
      </div>
    </Header>
    <div class="mx-safe my-4 px-4 md:p-6 lg:px-12">
      <main class="mx-auto max-w-7xl">
        {
          years.map(year => (
            <section class="mb-10 md:mb-14">
              <h2 class="font-display doodle-underline mb-4 inline-block px-1 text-4xl font-bold text-[#7c2d12] md:mb-6 dark:text-amber-300">
                {year}
              </h2>
              <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:gap-7 lg:grid-cols-3">
                {postsByYear[year].map((post, i) => (
                  <article class="paper-card relative rounded-sm p-4 pt-5 md:px-6">
                    {post.data.sticker ? (
                      <div class="absolute -top-7 -right-2">
                        <Sticker
                          name={post.data.sticker}
                          size={64}
                          label={`${post.data.sticker} sticker`}
                        />
                      </div>
                    ) : (
                      <div
                        class="tape -top-2.5 left-8"
                        style={`transform: rotate(${(i % 2 === 0 ? -4 : 5) + (year % 3)}deg);`}
                        aria-hidden="true"
                      />
                    )}
                    <h3 class="font-display text-xl font-bold text-[#3d3129] md:text-2xl dark:text-[#efe4cf]">
                      <a
                        class="decoration-wavy decoration-amber-500/70 hover:underline focus-visible:underline lg:decoration-2 lg:underline-offset-2"
                        href={`/${post.id}/`}
                      >
                        {post.data.title}
                      </a>
                    </h3>
                    <p class="font-handwritten mb-2 text-[#8a6f4d] md:text-lg dark:text-[#b8a88e]">
                      <FormattedDate date={post.data.date} />
                    </p>
                    <p
                      class="leading-snug text-[#5a4a3c] dark:text-[#d8cbb4]"
                      set:html={post.data.description || post.excerpt}
                    />
                  </article>
                ))}
              </div>
            </section>
          ))
        }
      </main>
    </div>
    <Footer />
  </body>
</html>
