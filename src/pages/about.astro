---
import BaseHead from "../components/BaseHead.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import Sticker from "../components/stickers/Sticker.astro"
import Unsplash from "../components/about/Unsplash.astro"
import Portfolio from "../components/about/Portfolio.astro"
import { SITE_TITLE } from "../consts"
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`About — ${SITE_TITLE}`} />
  </head>

  <body>
    <Header>
      <div
        class="font-display mt-6 flex justify-center pt-4 text-center sm:pt-8 md:pt-12"
      >
        <div class="relative inline-block">
          <img
            src="/oobavi3.svg"
            class="h-32 w-32 rounded-full bg-amber-800 lg:h-48 lg:w-48 dark:bg-amber-950"
            alt={`Cartoon render based on my Ooblets character.`}
          />
          <div class="absolute -right-6 -bottom-4">
            <Sticker name="pizza-slice" size={64} label="Pizza slice sticker" />
          </div>
        </div>
      </div>
    </Header>
    <div class="mx-safe my-4 px-4 md:p-6 lg:px-12">
      <main class="mx-auto max-w-3xl">
        <section
          class="paper-card corner-squircle relative mx-auto rounded-xl px-6 py-4 lg:-rotate-1 lg:rounded-3xl lg:px-8"
        >
          <div
            class="tape -top-3 left-1/2 -translate-x-1/2 rotate-2"
            aria-hidden="true"
          />
          <p
            class="font-display flex items-center justify-center text-xl text-[#7c2d12] sm:text-2xl md:text-3xl lg:text-4xl dark:text-amber-300"
          >
            <span class="doodle-underline">Hello!</span>
            <span class="ml-2" aria-label="Waving hand.">👋</span>
          </p>
          <div class="prose-all">
            <p>
              I'm a weird nerd that tinkers in all things computers.
              Professionally, I'm a web app developer, but I also do a lot of
              UI design, server setup, and really anything computery. I have
              some neat cats too. I'm on
              <a href="https://github.com/Alanaktion">GitHub</a>,
              <a href="https://bsky.app/profile/alan.pizza">Bluesky</a>,
              <a href="https://keybase.io/alanaktion">Keybase</a>, and
              <a href="https://last.fm/user/Alanaktion">Last.fm</a>, and
              probably other places too.
            </p>
          </div>
        </section>

        <hr />

        <Unsplash />

        <hr />

        <section
          class="paper-card corner-squircle relative mx-auto rounded-xl px-6 py-4 lg:mb-12 lg:rotate-1 lg:rounded-3xl lg:px-8"
        >
          <div
            class="tape -top-3 left-10 -rotate-3"
            aria-hidden="true"
          />
          <div class="mb-2 flex items-center justify-center gap-3">
            <Sticker name="pizza-slice" size={56} label="Pizza slice sticker" />
            <h2
              class="font-display doodle-underline text-2xl font-bold text-[#7c2d12] md:text-3xl dark:text-amber-300"
            >
              The pizza situation
            </h2>
          </div>
          <div class="prose-all">
            <p>
              I also run a <a href="https://alan.pizza">pizza blog</a>! I eat a
              lot of pizza (like, <i>too much</i> pizza), so I decided to
              document it. For a while when I first started the blog, I posted
              every time I ate pizza, but since that's often daily, I now only
              post new pizzas that I try for the first time. I try to give a
              simple review of each one, and while I find detailed food critique
              weird and difficult to do well, I enjoy writing the brief summary
              and posting the photos.
            </p>
          </div>
          <div class="items-center gap-4 sm:flex lg:gap-6">
            <picture>
              <source
                type="image/avif"
                srcset="https://alan.pizza/img/7xXDVJxNyD-800.avif 800w"
              />
              <source
                type="image/webp"
                srcset="https://alan.pizza/img/7xXDVJxNyD-800.webp 800w"
              />
              <img
                class="mx-auto my-2! aspect-4/3 rounded-sm text-sm sm:w-64"
                loading="lazy"
                decoding="async"
                src="https://alan.pizza/img/7xXDVJxNyD-800.jpeg"
                alt="A pizza in the box, half is pepperoni pizza and half is cheese breadsticks."
              />
            </picture>
            <div class="prose-all">
              <p>
                My current favorite pizza is the Little Caesar’s Slices-N-Stix.
                Half-pizza, half-Italian Cheese Bread!
              </p>
              <p>
                <a
                  class="font-display inline-flex items-center gap-1"
                  href="https://alan.pizza/2022/09/01/little-caesars-slices-n-stix/"
                >
                  View Post →
                </a>
              </p>
            </div>
          </div>
        </section>

        <hr />

        <div class="mb-4 flex items-center gap-3">
          <Sticker
            name="code-brackets"
            size={56}
            label="Code brackets sticker"
          />
          <h2
            class="font-display doodle-underline text-2xl font-bold text-[#3d3129] md:text-3xl dark:text-[#efe4cf]"
          >
            Things I've built
          </h2>
        </div>
        <Portfolio class="paper-card rounded-3xl px-4 py-4 lg:mb-12 lg:py-6" />
      </main>
    </div>
    <Footer />
  </body>
</html>
