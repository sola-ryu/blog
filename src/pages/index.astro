---
import BaseHead from "../components/BaseHead.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import Sticker from "../components/stickers/Sticker.astro"
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts"
import { getCollection, render } from "astro:content"
import FormattedDate from "../components/FormattedDate.astro"

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5)
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header>
      <div class="mt-6 pt-4 sm:py-8 md:py-12 lg:mt-8">
        <h1
          class="font-display doodle-underline inline-block text-4xl font-bold text-[#3d3129] md:text-5xl dark:text-[#efe4cf]"
        >
          My Blog
        </h1>
      </div>
    </Header>
    <div class="mx-safe my-4 px-4 md:p-6 lg:px-12">
      <main class="mx-auto max-w-3xl">
        {
          posts.map(async post => {
            const { Content } = await render(post)
            return (
              <article class="paper-card relative mb-10 flex flex-col rounded-sm px-6 py-6 sm:mb-14 md:mb-20 lg:px-10 lg:py-8">
                <div
                  class="tape -top-3 left-1/2 -translate-x-1/2 -rotate-2"
                  aria-hidden="true"
                />
                {post.data.sticker && (
                  <div class="absolute -top-10 -right-3 sm:-right-6">
                    <Sticker
                      name={post.data.sticker}
                      size={104}
                      label={`${post.data.sticker} sticker`}
                    />
                  </div>
                )}
                <header class="font-display mb-4 lg:mb-6">
                  <h3 class="text-3xl leading-10 font-bold text-[#3d3129] sm:text-4xl sm:leading-none dark:text-[#efe4cf]">
                    <a
                      class="decoration-wavy decoration-amber-500/70 hover:underline"
                      href={`/${post.id}/`}
                    >
                      {post.data.title}
                    </a>
                  </h3>
                  <div class="font-handwritten mt-1 text-lg text-[#8a6f4d] dark:text-[#b8a88e]">
                    <FormattedDate date={post.data.date} />
                  </div>
                </header>
                <section class="prose-all">
                  <Content />
                </section>
              </article>
            )
          })
        }

        <div class="md:mb-24">
          <a
            class="shadow-solid inline-block rounded-full bg-[#b3402a] px-5 py-2 font-bold text-[#fffdf6] shadow-[#7c2d12] hover:brightness-110 md:px-6 md:py-3 md:text-lg"
            href="/archive"
          >
            See more posts →
          </a>
        </div>
      </main>
    </div>
    <Footer />
  </body>
</html>
